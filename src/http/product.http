### Configuración de Variables
# Correr las requests en orden. Crea un admin temporal (necesita
# ADMIN_SECRET_KEY en el .env) y lo borra al final.
@baseUrl = http://localhost:3000/api/products
@usersUrl = http://localhost:3000/api/users
@authUrl = http://localhost:3000/api/auth
@adminSecretKey = {{$dotenv ADMIN_SECRET_KEY}}

### 1. Crear admin temporal
# @name createAdmin
POST {{usersUrl}}/admin
Content-Type: application/json

{
  "name": "Admin Productos",
  "email": "admin.productos.{{$timestamp}}@utn.edu",
  "password": "adminSecurePassword",
  "secretKey": "{{adminSecretKey}}"
}

### 2. Login como admin
# @name loginAdmin
POST {{authUrl}}/login
Content-Type: application/json

{
  "email": "{{createAdmin.response.body.email}}",
  "password": "adminSecurePassword"
}

###

@adminToken = {{loginAdmin.response.body.token}}

### 3. Listar catálogo (público, sin token)
GET {{baseUrl}}

### 4. Crear producto (requiere token de admin)
# @name createProduct
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "categoryId": null,
  "brand": "Xiaomi",
  "model": "Redmi Note 18",
  "description": "Smartphone gama media, 512GB",
  "price": 800000,
  "stock": 25,
  "imageUrl": "https://ejemplo.com/redmi-note-18.jpg"
}

###

@productId = {{createProduct.response.body.id}}

### 5. Intentar crear producto SIN token (401)
POST {{baseUrl}}
Content-Type: application/json

{
  "brand": "Hacker",
  "model": "Intento sin token",
  "description": "No debería crearse",
  "price": 1,
  "stock": 1
}

### 6. Intentar crear producto con precio inválido (400)
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "brand": "Xiaomi",
  "model": "Precio negativo",
  "price": -10,
  "stock": 1
}

### 7. Intentar eliminar SIN token (401)
DELETE {{baseUrl}}/{{productId}}

### 8. Eliminar el producto creado (requiere token de admin)
DELETE {{baseUrl}}/{{productId}}
Authorization: Bearer {{adminToken}}

### 9. Eliminar de nuevo el mismo producto (404)
DELETE {{baseUrl}}/{{productId}}
Authorization: Bearer {{adminToken}}

### 10. Limpieza: eliminar el admin temporal
DELETE {{usersUrl}}/{{createAdmin.response.body.id}}
Authorization: Bearer {{adminToken}}

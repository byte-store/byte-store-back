### Configuración de Variables
# Correr las requests en orden. Cada corrida crea su propio usuario y admin
# (con email único) y los borra al final, así se puede repetir sin errores.
@baseUrl = http://localhost:3000/api/users
@authUrl = http://localhost:3000/api/auth
@adminSecretKey = {{$dotenv ADMIN_SECRET_KEY}}

### 1. Crear un usuario común
# @name createUser
POST {{baseUrl}}
Content-Type: application/json

{
  "name": "Este Perez",
  "email": "este.perez.{{$timestamp}}@example.com",
  "password": "password123"
}

###

@createdUserId = {{createUser.response.body.id}}

### 2. Login con el usuario creado
# @name loginUser
POST {{authUrl}}/login
Content-Type: application/json

{
  "email": "{{createUser.response.body.email}}",
  "password": "password123"
}

###

@userToken = {{loginUser.response.body.token}}

### 3. Obtener el usuario creado con su propio token (200)
GET {{baseUrl}}/{{createdUserId}}
Authorization: Bearer {{userToken}}

### 4. Crear un Administrador
# @name createAdmin
POST {{baseUrl}}/admin
Content-Type: application/json

{
  "name": "Admin Universidad",
  "email": "admin.{{$timestamp}}@utn.edu",
  "password": "adminSecurePassword",
  "secretKey": "{{adminSecretKey}}"
}

###

@createdAdminId = {{createAdmin.response.body.id}}

### 5. Intentar crear Administrador con clave incorrecta (403)
POST {{baseUrl}}/admin
Content-Type: application/json

{
  "name": "Intruso",
  "email": "hacker@example.com",
  "password": "hack",
  "secretKey": "clave_incorrecta_2026"
}

### 6. Login como admin
# @name loginAdmin
POST {{authUrl}}/login
Content-Type: application/json

{
  "email": "{{createAdmin.response.body.email}}",
  "password": "adminSecurePassword"
}

###

@adminToken = {{loginAdmin.response.body.token}}

### 7. Obtener todos los usuarios (con token de admin)
GET {{baseUrl}}
Authorization: Bearer {{adminToken}}

### 8. Actualizar datos del usuario creado
PUT {{baseUrl}}/{{createdUserId}}
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "name": "Juan Carlos Perez"
}

### 9. Intentar auto-asignarse rol admin (403)
PUT {{baseUrl}}/{{createdUserId}}
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "role": "admin"
}

### 10. Eliminar al usuario creado
DELETE {{baseUrl}}/{{createdUserId}}
Authorization: Bearer {{userToken}}

### 11. Buscar al usuario eliminado (404, con token de admin)
GET {{baseUrl}}/{{createdUserId}}
Authorization: Bearer {{adminToken}}

### 12. Limpieza: eliminar el admin creado
DELETE {{baseUrl}}/{{createdAdminId}}
Authorization: Bearer {{adminToken}}

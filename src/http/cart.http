@host = http://localhost:3000
@userId = 10
@cartsUrl = {{host}}/api/carts
# usar id de un producto que exista
@productId = 1

### Login (obtiene el token)
# @name login
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "Este.perez@example.com",
  "password": "password123"
}

###
@token = {{login.response.body.token}}

### Ver carrito del usuario
GET {{cartsUrl}}/{{userId}}
Authorization: Bearer {{token}}

### Agregar producto al carrito
POST {{cartsUrl}}/{{userId}}/items
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "productId": {{productId}},
  "quantity": 2
}

### Cambiar cantidad del item
PATCH {{cartsUrl}}/{{userId}}/items/{{productId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "quantity": 7
}

### Quitar item del carrito
DELETE {{cartsUrl}}/{{userId}}/items/{{productId}}
Authorization: Bearer {{token}}

### Vaciar carrito completo
DELETE {{cartsUrl}}/{{userId}}/items
Authorization: Bearer {{token}}

### Error: sin token (401)
GET {{cartsUrl}}/{{userId}}

### Error: token inválido (403)
GET {{cartsUrl}}/{{userId}}
Authorization: Bearer token.falso.123

### Error: cantidad cero (400)
POST {{cartsUrl}}/{{userId}}/items
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "productId": {{productId}},
  "quantity": 0
}

### Error: producto inexistente (404)
POST {{cartsUrl}}/{{userId}}/items
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "productId": 999999,
  "quantity": 1
}

### Error: item no está (404)
PATCH {{cartsUrl}}/{{userId}}/items/999999
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "quantity": 3
}

### Error: borrar item inexistente (404)
DELETE {{cartsUrl}}/{{userId}}/items/999999
Authorization: Bearer {{token}}

### Error: userId inválido (403 si no sos admin, 400 si sos admin)
GET {{cartsUrl}}/abc
Authorization: Bearer {{token}}
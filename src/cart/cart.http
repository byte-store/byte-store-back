@host = http://localhost:3000
@productId = 5

### Login como admin (para crear el producto)
# @name loginAdmin
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "admin@utn.edu",
  "password": "adminSecurePassword"
}

###

@adminToken = {{loginAdmin.response.body.token}}

### Login con un usuario ya existente
# @name loginUser
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "juan.perez@example.com",
  "password": "password123"
}

###

@userToken = {{loginUser.response.body.token}}
@userId = 1

### resto de las requests igual, usando {{userId}} y {{userToken}}